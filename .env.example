# ---------------------------------------------------------------- agent brain
# Which LLM answers /chat. One line, three choices — see llm/providers/ for the
# full per-provider variable map. Changing it needs a server restart.
LLM_PROVIDER=gemini

# --- anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=8192

# --- gemini (free tier — the demo default) -----------------------------------
# Free tier is rate-limited PER MINUTE (measured: 5 requests/min on
# gemini-2.5-flash) and one buyer message costs 2-3 requests, so 429s are
# normal. The adapter honours the retry delay Google returns instead of failing
# the turn — a busy demo just pauses ~15s. gemini-2.5-flash-lite has a higher
# free-tier limit if you need more headroom during a live run.
GEMINI_API_KEY=AIza-xxx
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=8192
# Thinking budget: unset = model default. 0 disables thinking on 2.x models
# (faster, fewer free-tier tokens). Do NOT set 0 for gemini-3.x — it rejects it.
# GEMINI_THINKING_BUDGET=0
# Extra attempts on 429 / 5xx, and the cap on one backoff sleep:
# GEMINI_RETRIES=3
# GEMINI_MAX_RETRY_WAIT=30

# --- openai ------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5.1
# OPENAI_MAX_TOKENS=8192
# OPENAI_BASE_URL=

# Prava API secret key
PRAVA_SECRET_KEY=sk_test_xxx

# Prava sandbox backend URL
PRAVA_BACKEND_URL=https://sandbox.api.prava.space

# Human-only safety gate for a real sandbox session. Leave off for normal UI
# work; set to 1 only for one explicitly approved transaction.
PRAVA_ALLOW_REAL=0

# Legal/business country of the controlled GiftWrap demo merchant. This is NOT
# the shopper's market or the checkout currency. The present demo store is US.
# PRAVA_MERCHANT_COUNTRY remains supported for older local .env files.
PRAVA_DEMO_MERCHANT_COUNTRY=US

# Shopify dev store URL
SHOPIFY_DEV_STORE_URL=https://your-store.myshopify.com

# Shopify product URL for testing
SHOPIFY_DEV_STORE_PRODUCT_URL=https://your-store.myshopify.com/products/your-product

# Canonical, separately labelled sandbox checkout card. This is not fetched
# through UCP, so a password-gated dev storefront can stay private. Keep these
# values in sync with a manually verified one-time-purchase product.
SHOPIFY_DEMO_PRODUCT_TITLE=Selling Plans Ski Wax
SHOPIFY_DEMO_PRODUCT_PRICE=1499.00
SHOPIFY_DEMO_PRODUCT_CURRENCY=INR
# Must equal the latest no-Pay checkout total, not merely the item price.
SHOPIFY_DEMO_CHECKOUT_CAP=1945.70

# Shopify storefront password (optional, for password-gated dev stores)
SHOPIFY_STOREFRONT_PASSWORD=

# Checkout shipping-address region: IN (default) or US. Must match the dev
# store's region -- a US store rejects the Indian default address.
CHECKOUT_ADDRESS_COUNTRY=US

# Default UCP store domain
UCP_DEFAULT_STORE=giva-jewelry.myshopify.com

# Optional: set to 1 to hide third-party UCP browsing. The separate sandbox
# checkout card remains available; do not expect the password-gated dev store
# to return buyer catalog results through UCP.
UCP_DEMO_STORE_ONLY=0
